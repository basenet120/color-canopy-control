.DS_Store

# Client decks, the private text-message screenshot, and our exported briefs stay local;
# docs/context/ summarizes everything the build needs
Ref Docs/
/*.pdf
/*.docx

# Secrets — Hubspace credentials and refresh tokens never enter git
.env
.env.*
!.env.example
secrets/
*.token.json

# Python / Node
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local runtime output (bench reports worth keeping go in reports/ explicitly)
reports/local/
*.sqlite
*.sqlite-journal
*.log
