.DS_Store

# Client decks, the private text-message screenshot, and exported briefs stay local;
# docs/context/ summarizes everything the build needs
Ref Docs/
*.pdf
*.docx

# Secrets — Hubspace passwords and refresh tokens never enter git
.env
.env.*
!.env.example
secrets/
*.token.json

# Release images (scripts/release.sh): tarballs never enter git
dist/

# Local runtime data (the default CONDUCTOR_DATA_DIR) and bench output
var/
reports/local/
*.sqlite
*.sqlite-journal
*.log

# Python / Node / Playwright
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
test-results/
playwright-report/
blob-report/
*.trace.zip
