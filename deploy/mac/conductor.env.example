# The Conductor's settings on the Mac show box (D61, docs/runbooks/mac-show-box.md). `canopy-mac install` copies this
# to ~/Library/Application Support/ColorCanopy/conductor.env (mode 0600), generates the two secrets and fills in the
# show accounts. Never commit, copy or paste the filled-in file anywhere.
# Format: one KEY=value per line, no spaces around =, no quotes. run-conductor.sh reads it line by line; it is never
# executed as a shell script.

# ---- What this runtime is (07 §1) --------------------------------------------------------------------------------
# live = the show engine drives the real modules through Hubspace. The show box is the only live runtime.
CONDUCTOR_MODE=live
# 1 = Hubspace calls are allowed at all. live refuses to start without it.
HUBSPACE_LIVE=1
# registry = write only to devices registered on /ops/accounts and marked writable (show box only).
HUBSPACE_DEVICE_ALLOWLIST=registry
# The show accounts' emails, comma-separated: canopy first, then the vignette accounts. A sign-in for any other
# email is refused before a password leaves the Mac. Empty = no account can sign in (nothing reaches Hubspace).
HUBSPACE_ACCOUNT_ALLOWLIST=
# After this date (UTC) the box refuses every Hubspace write. Home Depot's authorization runs to Nov 2.
HUBSPACE_LIVE_UNTIL=2026-11-02
# Binds the stored sign-ins to this box: a token file from staging or a workshop laptop can't load here.
CONDUCTOR_ENV=venue

# ---- Secrets (canopy-mac install generates them; never paste them into chat, git or a ticket) ----------------------
# The ops login for /ops and the API, as user:password. `canopy-mac password` shows it, on this Mac only.
CONDUCTOR_BASIC_AUTH=
# Fernet key that encrypts the stored Hubspace sign-ins in the data folder. Losing it only means signing in again.
CONDUCTOR_SECRET_KEY=

# ---- Where it listens -------------------------------------------------------------------------------------------
# Tablets and staff phones open http://<this Mac's show-network address>:8000/. 0.0.0.0 = every network interface.
CANOPY_BIND=0.0.0.0
CANOPY_PORT=8000

# ---- Pinned or unset on the show box ------------------------------------------------------------------------------
# CONDUCTOR_DATA_DIR is pinned by run-conductor.sh to ~/Library/Application Support/ColorCanopy/data, so a typo here
# can't move the sign-ins and the registry overlay. These must stay unset (the same list as deploy/venue/):
# CONDUCTOR_ACCOUNT_CONNECT=1   (sign in with `canopy-mac login` instead; if you set it, remove it afterwards)
# CONDUCTOR_AUTH=off            (a live runtime refuses to start with it)
# CONDUCTOR_ENGINE=off          (tests only)
# CONDUCTOR_SIM_SPEED=fast      (simulator only)
# FORWARDED_ALLOW_IPS=*         (Railway staging only)
# RAILWAY_ENVIRONMENT_NAME=     (would make the box act like staging)
