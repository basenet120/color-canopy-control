# The Conductor's settings on the venue box. Copy to /etc/canopy/conductor.env (owner root, mode 0600), fill in the
# three secrets, and never commit the filled-in copy anywhere:
#   sudo install -o root -g root -m 0600 -D deploy/venue/conductor.env.example /etc/canopy/conductor.env
#   sudo nano /etc/canopy/conductor.env
# Format: one KEY=value per line, no spaces around =, no quotes needed. Keep secrets to letters, digits, - and _
# (compose would try to expand a $). The installer and the service refuse to start while this file is missing,
# readable by anyone but root, or wrong. Every variable the Conductor reads is listed here; the commented ones
# must stay unset on the venue box.

# ---- What this runtime is (07 §1) --------------------------------------------------------------------------------
# live = the show engine drives the real modules through Hubspace. The venue box is the only live runtime.
CONDUCTOR_MODE=live
# 1 = Hubspace calls are allowed at all. live refuses to start without it.
HUBSPACE_LIVE=1
# registry = write only to devices registered on /ops/accounts and marked writable (venue box only).
HUBSPACE_DEVICE_ALLOWLIST=registry
# The show accounts' emails, comma-separated: canopy first, then the vignette accounts. A sign-in for any other
# email is refused before a password leaves the box. Example: canopy@example.invalid,living@example.invalid
HUBSPACE_ACCOUNT_ALLOWLIST=
# After this date (UTC) the box refuses every Hubspace write. Home Depot's authorization runs to Nov 2.
HUBSPACE_LIVE_UNTIL=2026-11-02
# Binds the stored sign-ins to this box: a token file from staging can't load here, and vice versa.
CONDUCTOR_ENV=venue
# Where sign-ins, the registry overlay, slot hashes, enrolled devices and telemetry live: the canopy-data volume.
# (docker-compose.yml pins this to /data as well.)
CONDUCTOR_DATA_DIR=/data

# ---- Secrets (fill these in on the box; never paste them into chat, git or a ticket) -----------------------------
# The ops login for /ops and the API, as user:password (12+ character password). Make a password with:
#   openssl rand -hex 12
# Write it on the ops card that lives with the box; the second on-duty person needs it too.
CONDUCTOR_BASIC_AUTH=
# Fernet key that encrypts the stored Hubspace sign-ins (refresh tokens) in the data volume. Make one with:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_'
# Anyone with this file and the volume (or a backup) can use the sign-ins: keep the file 0600, and keep backups
# away from this file. Losing the key only means signing in to each account again.
CONDUCTOR_SECRET_KEY=

# ---- Leave these unset on the venue box --------------------------------------------------------------------------
# 1 turns on the sign-in form on /ops/accounts until one account connects. Use the command line instead
# (docs/runbooks/install-day-commissioning.md); if you do set it, remove it again afterwards.
# CONDUCTOR_ACCOUNT_CONNECT=1
# off disables the ops login. Local development only; a live runtime refuses to start with it.
# CONDUCTOR_AUTH=off
# off runs without the canopy engine. Tests only.
# CONDUCTOR_ENGINE=off
# fast shortens simulated latency. Simulator tests and demos only; it does nothing on hardware.
# CONDUCTOR_SIM_SPEED=fast
# The server the bench and sign-in command-line tools talk to. For those tools only, not the server.
# CONDUCTOR_URL=http://127.0.0.1:8000
# Trust X-Forwarded-* headers from these addresses. Railway staging only (behind its proxy); the venue box has none.
# FORWARDED_ALLOW_IPS=*
# The port inside the container. docker-compose.yml pins it to 8000.
# PORT=8000
# Set by Railway on staging. Never on the venue box: they would make the box act like staging.
# RAILWAY_ENVIRONMENT_NAME=staging
# RAILWAY_GIT_COMMIT_SHA=
