# Non-secret settings for the venue box: /etc/canopy/box.env (root, 0644). install.sh creates it and keeps
# CONDUCTOR_TAG current; canopy-restart --tag switches it (rollback). Nothing secret goes in this file.

# The release the Conductor runs: the image canopy-conductor:<tag>, built from the git tag of the same name.
CONDUCTOR_TAG=v2026.10.12-1
# The box's fixed address on the show network. Tablets and staff phones open http://<this address>:8000/.
# Set it as a static address (netplan) or a DHCP reservation on the show router, never a changing one.
CONDUCTOR_LAN_IP=192.168.50.10
# The desktop user that auto-logs in and runs the kiosk browser (canopy-kiosk.service).
CANOPY_KIOSK_USER=kiosk
# Nightly backups of the canopy-data volume: how many days to keep.
CANOPY_BACKUP_KEEP_DAYS=14
# Optional: where a USB stick is mounted for a second copy of each backup (leave empty for none).
# The copy is skipped, with a warning in the log, when nothing is mounted there.
CANOPY_BACKUP_USB=
