#!/usr/bin/env bash
# canopy-restore — put a backup back into the canopy-data volume.
set -uo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

usage() {
	cat <<'USAGE'
Usage: sudo canopy-restore FILE [--skip-tokens] [--yes]

Replaces everything in the canopy-data volume with the backup FILE (from sudo canopy-backup --list):
  1. checks the file against its .sha256 (if it's next to it) and that it's a canopy backup;
  2. stops the Conductor (the lights keep their look; the kiosk shows "resting");
  3. saves what the volume holds now as canopy-data-<date>-before-restore.tar.gz, then empties it;
  4. unpacks the backup and starts the Conductor again (unless break-glass hold is on).
About 1-2 minutes. Afterwards check /ops: sign-ins, Needs attention, the 7 am checklist.

  --skip-tokens  leave the stored Hubspace sign-ins out: for a cold spare box or a backup made on another box
                 (sign-ins are never copied between boxes). Then sign in to each account again on this box.
  --yes          don't ask first
  -h, --help     this help

A sign-in from a backup may no longer work (Hubspace replaces the sign-in every few minutes); if /ops says
"re-sign-in required", sign in again (docs/runbooks/outages.md).
USAGE
}

file=""
skip_tokens=0
yes=0
while [ $# -gt 0 ]; do
	case $1 in
	-h | --help) usage && exit 0 ;;
	--skip-tokens) skip_tokens=1 ;;
	--yes) yes=1 ;;
	-*) usage >&2 && exit 2 ;;
	*) [ -z "$file" ] || { usage >&2 && exit 2; }; file=$1 ;;
	esac
	shift
done
[ -n "$file" ] || { usage >&2 && exit 2; }
need_root "$@"

[ -f "$file" ] || die "There's no file $file. List backups with: sudo canopy-backup --list"
if [ -f "$file.sha256" ]; then
	sha256_matches "$file" || die "$file doesn't match its .sha256: it's damaged or incomplete. Pick another backup."
else
	warn "No $file.sha256 next to it, so the file can't be checked. Carrying on."
fi
listing=$(tar --list --gzip --file "$file") || die "$file isn't a readable backup."
if printf '%s\n' "$listing" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
	die "$file has paths outside its own folder. Refusing to unpack it."
fi
printf '%s\n' "$listing" | grep -Eq '^\./(overrides|roles|tokens|telemetry)(/|$)' ||
	die "$file doesn't look like a canopy-data backup (no overrides/, roles/, tokens/ or telemetry/)."

if [ "$yes" -ne 1 ]; then
	read -r -p "Replace the canopy data on this box with $(basename "$file")? Type restore: " answer
	[ "$answer" = "restore" ] || die "Nothing changed."
fi

was_active=0
conductor_active && was_active=1
say "Stopping the Conductor…"
systemctl stop "$CANOPY_UNIT"
if [ "$(docker inspect --format '{{ .State.Running }}' "$CANOPY_CONTAINER" 2>/dev/null)" = "true" ]; then
	die "The Conductor is still running, so nothing was changed. Try: sudo systemctl stop $CANOPY_UNIT"
fi

docker volume inspect "$CANOPY_VOLUME" >/dev/null 2>&1 || docker volume create "$CANOPY_VOLUME" >/dev/null
mount=$(volume_path)
[ -n "$mount" ] && [ -d "$mount" ] || die "Can't find the data volume's folder. The Conductor is stopped: sudo canopy-start (or systemctl start $CANOPY_UNIT) once fixed."

if [ -n "$(ls -A "$mount")" ]; then
	install -d -m 0700 "$CANOPY_BACKUP_DIR"
	safety=$CANOPY_BACKUP_DIR/canopy-data-$(date +%Y%m%dT%H%M%S)-before-restore.tar.gz
	(umask 077 && tar --create --gzip --file "$safety" --directory "$mount" .) ||
		die "Couldn't save the current data first, so nothing was changed. The Conductor is stopped: sudo systemctl start $CANOPY_UNIT"
	say "Saved the current data as $safety."
	find "$mount" -mindepth 1 -delete
fi

excludes=()
if [ "$skip_tokens" -eq 1 ]; then
	excludes=(--exclude=./tokens --exclude='./tokens/*')
fi
tar --extract --gzip --file "$file" --directory "$mount" --numeric-owner "${excludes[@]}" ||
	die "Unpacking failed. The previous data is in $CANOPY_BACKUP_DIR (…-before-restore). The Conductor is stopped."
say "Restored $(basename "$file")$([ "$skip_tokens" -eq 1 ] && printf ' without the stored sign-ins')."

if held; then
	say "Break-glass hold is on, so the Conductor stays stopped. Hand it back with: sudo canopy-start"
elif [ "$was_active" -eq 1 ] || systemctl is-enabled --quiet "$CANOPY_UNIT"; then
	systemctl start "$CANOPY_UNIT"
	wait_healthy 120 || die "The Conductor hasn't answered after 2 minutes: sudo canopy-logs service"
	say "Check /ops now: accounts (sign in again if asked), Needs attention, and the 7 am checklist."
fi
