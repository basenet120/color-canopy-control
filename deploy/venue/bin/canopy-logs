#!/usr/bin/env bash
# canopy-logs — read the venue box's logs.
set -uo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

usage() {
	cat <<'USAGE'
Usage: sudo canopy-logs [conductor|watchdog|backup|kiosk|service] [--since 1h] [--follow]

  conductor  (default) the Conductor's own log: every command, readback and alert (secrets are redacted),
             since its container was last created (every restart makes a new one)
  watchdog   the 30-second health checks and any automatic restarts
  backup     the nightly backups
  kiosk      the kiosk browser on the touchscreen
  service    when the Conductor's service started, stopped or failed to start (and why), and the Conductor's
             own log across restarts: use this for anything before the last restart (e.g. why the watchdog
             restarted it)

  --since T  how far back, e.g. 10m, 2h, 1d (default 1h)
  --follow   keep printing new lines (Ctrl-C to stop)
  -h, --help this help

The same log tail is on /ops ("Log") without a terminal.
USAGE
}

what=conductor
since=1h
follow=()
while [ $# -gt 0 ]; do
	case $1 in
	-h | --help) usage && exit 0 ;;
	--since) since=${2:?--since needs a value like 2h} && shift ;;
	--since=*) since=${1#--since=} ;;
	-f | --follow) follow=(--follow) ;;
	conductor | watchdog | backup | kiosk | service) what=$1 ;;
	*) usage >&2 && exit 2 ;;
	esac
	shift
done
[[ $since =~ ^[0-9]+[smhd]$ ]] || die "--since takes a number and a unit: 10m, 2h or 1d."
need_root "$@"

# journalctl takes "-2h" / "-1d"; docker takes Go durations, which have no days.
journal_since="-$since"
docker_since=$since
[[ $since == *d ]] && docker_since="$((${since%d} * 24))h"
case $what in
conductor)
	# Every restart (watchdog, canopy-restart, reboot) runs `compose down`, which removes the container and its log.
	created=$(docker inspect --format '{{ .Created }}' "$CANOPY_CONTAINER" 2>/dev/null || true)
	printf 'Only since the Conductor last (re)started%s. Anything before that: sudo canopy-logs service --since %s\n' \
		"${created:+ (container created $created)}" "$since" >&2
	exec docker logs --since "$docker_since" "${follow[@]}" "$CANOPY_CONTAINER"
	;;
watchdog) exec journalctl -u canopy-watchdog.service --since "$journal_since" --no-pager "${follow[@]}" ;;
backup) exec journalctl -u canopy-backup.service --since "$journal_since" --no-pager "${follow[@]}" ;;
kiosk)
	# Not --user-unit: run as root, that matches only root's own user units (_UID=0). Match the kiosk user's instead.
	user=$(kiosk_user)
	uid=$(id -u "$user" 2>/dev/null) || die "There's no user $user on this box (CANOPY_KIOSK_USER in $CANOPY_BOX_FILE)."
	exec journalctl _UID="$uid" _SYSTEMD_USER_UNIT="$CANOPY_KIOSK_UNIT" + _UID="$uid" USER_UNIT="$CANOPY_KIOSK_UNIT" \
		--since "$journal_since" --no-pager "${follow[@]}"
	;;
service) exec journalctl -u "$CANOPY_UNIT" --since "$journal_since" --no-pager "${follow[@]}" ;;
esac
