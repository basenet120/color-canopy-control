#!/usr/bin/env bash
# canopy-backup — back up the canopy-data volume (sign-ins, registry overlay, slot hashes, enrolled devices, telemetry).
set -uo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

usage() {
	cat <<'USAGE'
Usage: sudo canopy-backup [--to DIR] [--telemetry-only] [--list] [--nightly]

Writes /var/backups/canopy/canopy-data-<date>-<kind>.tar.gz (mode 0600) and a .sha256 next to it, copies both
to the USB stick if CANOPY_BACKUP_USB is set in /etc/canopy/box.env and mounted, and deletes backups older than
CANOPY_BACKUP_KEEP_DAYS (14). The Conductor keeps running. The nightly timer runs it at 04:30.

  --to DIR          write the backup to DIR instead (e.g. a USB stick at strike); nothing is pruned there
  --telemetry-only  only the telemetry folder (the command log), e.g. for the case study at strike
  --list            list the backups on this box, newest first
  --nightly         what the timer runs (the same backup, labelled nightly)
  -h, --help        this help

The stored Hubspace sign-ins in a backup are encrypted with CONDUCTOR_SECRET_KEY, which is NOT in the backup
(it's in /etc/canopy/conductor.env). Restore with: sudo canopy-restore <file>
USAGE
}

kind=manual
to=""
telemetry=0
list=0
while [ $# -gt 0 ]; do
	case $1 in
	-h | --help) usage && exit 0 ;;
	--to) to=${2:?--to needs a folder} && shift ;;
	--to=*) to=${1#--to=} ;;
	--telemetry-only) telemetry=1 ;;
	--list) list=1 ;;
	--nightly) kind=nightly ;;
	*) usage >&2 && exit 2 ;;
	esac
	shift
done
need_root "$@"

if [ "$list" -eq 1 ]; then
	ls -1t "$CANOPY_BACKUP_DIR"/*.tar.gz 2>/dev/null | while read -r f; do
		printf '%s  %s  %s\n' "$(date -r "$f" '+%a %d %b %H:%M')" "$(du -h "$f" | cut -f1)" "$f"
	done
	exit 0
fi

mount=$(volume_path) || true
[ -n "$mount" ] && [ -d "$mount" ] || die "The data volume $CANOPY_VOLUME doesn't exist on this box: nothing to back up."

dest=${to:-$CANOPY_BACKUP_DIR}
install -d -m 0700 "$dest" || die "Can't create $dest."
stamp=$(date +%Y%m%dT%H%M%S)
if [ "$telemetry" -eq 1 ]; then
	[ -d "$mount/telemetry" ] || die "There's no telemetry in the data volume yet."
	name=canopy-telemetry-$stamp.tar.gz
	what=(telemetry)
else
	name=canopy-data-$stamp-$kind.tar.gz
	what=(.)
fi

umask 077
tmp=$(mktemp "$dest/.partial.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# Files are written atomically (write + rename) by the Conductor, so a live copy is consistent per file.
tar --create --gzip --file "$tmp" --directory "$mount" --warning=no-file-changed "${what[@]}"
rc=$?
# tar exits 1 when a file changed while it was read (telemetry is appended to all day): that's fine.
[ "$rc" -le 1 ] || die "The backup failed (disk full? see above). Nothing was written."
mv -f "$tmp" "$dest/$name"
trap - EXIT
(cd "$dest" && sha256sum "$name" >"$name.sha256")
chmod 0600 "$dest/$name" "$dest/$name.sha256"
say "Backed up to $dest/$name ($(du -h "$dest/$name" | cut -f1))."

prune() { # prune DIR: delete backups older than CANOPY_BACKUP_KEEP_DAYS
	local dir=$1 keep
	keep=$(env_value "$CANOPY_BOX_FILE" CANOPY_BACKUP_KEEP_DAYS)
	case $keep in '' | *[!0-9]* | 0) keep=14 ;; esac
	find "$dir" -maxdepth 1 -type f \( -name 'canopy-data-*.tar.gz' -o -name 'canopy-data-*.tar.gz.sha256' \) \
		-mtime +"$((keep - 1))" -print -delete | sed 's/^/Deleted old backup: /'
}

if [ -z "$to" ] && [ "$telemetry" -eq 0 ]; then
	prune "$dest"
	usb=$(env_value "$CANOPY_BOX_FILE" CANOPY_BACKUP_USB)
	if [ -n "$usb" ]; then
		if mountpoint -q "$usb"; then
			install -d -m 0700 "$usb/canopy-backups" &&
				cp "$dest/$name" "$dest/$name.sha256" "$usb/canopy-backups/" &&
				say "Copied to the USB stick: $usb/canopy-backups/$name" &&
				prune "$usb/canopy-backups"
		else
			warn "The USB copy was skipped: nothing is mounted at $usb (CANOPY_BACKUP_USB in $CANOPY_BOX_FILE)."
		fi
	fi
fi
